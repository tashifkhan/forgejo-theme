  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#777e94"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage",
        "storage.type.function",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff7540"
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "keyword.type",
        "support.type.primitive",
        "storage.type.builtin"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#ff7540"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "string.escape",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#ff8540"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9075cd"
      }
    },
    {
      "name": "Numbers & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#649bc4"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#ffaa10"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#ff7540"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "storage.type.class.this"
      ],
      "settings": {
        "foreground": "#649bee"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.property-name",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#b6bac5"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.variable"
      ],
      "settings": {
        "foreground": "#c9d1d9"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#c9d1d9"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#d2d4db"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#c9d1d9"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "JSON keys / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "string.unquoted.key"
      ],
      "settings": {
        "foreground": "#b6bac5"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ffaa10",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#649bc4"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ddee30",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#87ab63"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#cc4848"
      }
    }
  ]
}
