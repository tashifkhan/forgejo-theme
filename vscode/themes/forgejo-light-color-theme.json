  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a737d"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage",
        "storage.type.function",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d73a49"
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "keyword.type",
        "support.type.primitive",
        "storage.type.builtin"
      ],
      "settings": {
        "foreground": "#445588"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#d73a49"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#106303"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "string.escape",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#994400"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4c4dbc"
      }
    },
    {
      "name": "Numbers & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#009999"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#445588"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#22863a"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#d73a49"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#3c5d5d"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "storage.type.class.this"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.property-name",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.variable"
      ],
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#109295"
      }
    },
    {
      "name": "JSON keys / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "string.unquoted.key"
      ],
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#6f42c1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#24292e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#24292e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#106303"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#22863a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#d73a49"
      }
    }
  ]
}
